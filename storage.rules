rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function roleValue() {
      return isSignedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : "";
    }

    function canReadMedia() {
      return roleValue() in ["owner", "coach", "dad", "proskater", "media", "skater"];
    }

    function canWriteMedia() {
      return roleValue() in ["owner", "coach", "dad", "proskater"] || request.auth.token.admin == true;
    }

    function validMediaUpload() {
      return request.resource != null
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
    }

    // Suggested media namespace for AthleteFlow assets.
    match /athleteflow/{allPaths=**} {
      allow read: if isSignedIn() && canReadMedia();
      allow write: if isSignedIn() && canWriteMedia() && validMediaUpload();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
